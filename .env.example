# Vestra environment configuration.
# Copy to .env and fill in real values. Do NOT commit .env (it is gitignored).

# Groq LLM API key (required) — used by the strategy node.
GROQ_API_KEY=

# MongoDB connection string (required).
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017
MONGODB_URI=

# Mongo database name (optional, defaults to "vestra").
DATABASE_NAME=vestra

# Groq model id (optional, defaults to llama-3.3-70b-versatile).
GROQ_MODEL=llama-3.3-70b-versatile

# --- Auth / security ---------------------------------------------------------
# JWT signing secret (required). Must be at least 32 chars.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# JWT options (optional).
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Shared API key for the machine-to-machine /webhook/market-alert endpoint.
# The webhook is fail-closed: if this is unset, all webhook calls are rejected.
WEBHOOK_API_KEY=

# --- Market data -------------------------------------------------------------
# "static" (default, no network I/O) or "yfinance" (live; falls back to static).
# yfinance is an optional dependency — see requirements.txt.
MARKET_DATA_PROVIDER=static

# --- Phase 1: approval / intelligence ----------------------------------------
# Default human-approval policy when an investor profile does not set one:
#   manual              -> always require human approval
#   approval_required   -> require approval for any non-HOLD trade (default)
#   auto_below_threshold-> auto-execute only when confidence high + risk below cap
#   autonomous_sandbox  -> never interrupt (paper/demo only)
APPROVAL_POLICY_DEFAULT=approval_required

# Thresholds used by the auto_below_threshold policy.
CONFIDENCE_THRESHOLD=0.7
RISK_THRESHOLD=high

# Telegram approval bot (optional). When TELEGRAM_BOT_TOKEN is unset, the
# notifier no-ops and approvals stay actionable via the REST API / frontend.
TELEGRAM_BOT_TOKEN=
# Fallback chat id when an investor profile has no telegram_chat_id.
TELEGRAM_DEFAULT_CHAT_ID=
# Optional shared secret enforced on POST /telegram/webhook (match setWebhook's
# secret_token). Recommended in production.
TELEGRAM_WEBHOOK_SECRET=


